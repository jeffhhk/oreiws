# OREI UHD-404R HDMI Matrix Switch

# output configuration: represented as a list of 4 elements
# input configuration: represented as numbers 1-4
# Mnemonic: SwS: "Switch setting"
# write each sws as:
#  [input for output 1, input for output 2, ...]

title:
  Video Switch
device_path:
  /dev/serial/by-id/usb-FTDI_USB_Serial_Converter_FTB6SPL3-if00-port0
choices:
  - label: speaker
    sws: [2,1,1,1]
  - label: music
    sws: [3,1,1,1]
  - label: discussion
    sws: [2,4,4,1]
